    {
      "id": "code-parse",
      "name": "Parse Assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        300
      ],
      "parameters": {
        "jsCode": "const output = $input.first().json.output;\nlet assets = [];\ntry {\n  const m = output.match(/\\{[\\s\\S]*\\}/);\n  if (m) {\n    const parsed = JSON.parse(m[0]);\n    assets = parsed.assets || [];\n  }\n} catch(e) { assets = []; }\nconst campaign_id = $('Get Campaign').item.json.campaign_id;\nreturn assets.map((a, i) => ({json: {...a, campaign_id, asset_id: campaign_id + '-' + (i+1), asset_type: 'copy', status: 'draft', created_at: new Date().toISOString()}}));"
      }
    },
    {
