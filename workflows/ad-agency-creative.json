        850,
        300
      ],
      "parameters": {
        "text": "Generate ad copy variations for:\n\nCampaign: {{ $('Get Campaign').item.json.campaign_name }}\nObjective: {{ $('Get Campaign').item.json.objective }}\nClient: {{ $json.company_name }}\nTone: {{ $json.tone_of_voice }}\n\nReturn JSON:\n{\"assets\": [{\"headline\": \"\", \"body_copy\": \"\", \"cta_text\": \"\", \"predicted_score\": 0-100}]}\n\nGenerate 15 variations with different angles.",
        "agent": "conversationalAgent",
        "options": {
          "systemMessage": "You are an expert copywriter generating high-converting ad variations."
        },
        "promptType": "define"
      }
    },
    {
      "id": "claude-model",
