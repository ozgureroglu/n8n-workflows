    {
      "id": "code-parse",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1650,
        300
      ],
      "parameters": {
        "jsCode": "const output = $input.first().json.output;\nlet parsed;\ntry {\n  const m = output.match(/\\{[\\s\\S]*\\}/);\n  parsed = m ? JSON.parse(m[0]) : {extracted_data:{},confidence_score:0,clarifying_questions:['Parse error']};\n} catch(e) {\n  parsed = {extracted_data:{},confidence_score:0,clarifying_questions:['Parse error']};\n}\nreturn [{json:{...parsed,client_id:$('Merge Inputs').item.json.client_id,transcript:$('Merge Inputs').item.json.transcript}}];"
      }
    },
