      "parameters": {
        "jsCode": "const workflows = $('Aggregate all files').first().json.workflows;\n\nconst tree = workflows.map((w) => ({\n  path: w.fileName,\n  mode: '100644',\n  type: 'blob',\n  content: w.content,\n}));\n\nreturn [{\n  json: {\n    tree,\n    baseTreeSha: $json.tree.sha,\n    parentCommitSha: $('Get branch ref').first().json.object.sha,\n  },\n}];"
      }
    },
