    {
      "id": "e2c2fe86-9ff5-4da7-8dc0-9342f38e5536",
      "name": "Check if the attachment is PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        256
      ],
      "parameters": {
        "jsCode": "const items = [];\n\nfor (const item of $input.all()) {\n  const binaryData = item.binary;\n  \n  // Check if this item has binary data\n  if (!binaryData) {\n    continue; // Skip items without binary data\n  }\n  \n  // Get the first binary property (assuming single file per item)\n  const binaryKey = Object.keys(binaryData)[0];\n  if (!binaryKey) {\n    continue; // Skip if no binary key found\n  }\n  \n  const fileData = binaryData[binaryKey];\n  \n  // Check if the file has a filename or content type\n  let isPdf = false;\n  \n  // Method 1: Check filename extension\n  if (fileData.fileName) {\n    const extension = fileData.fileName.toLowerCase().split('.').pop();\n    isPdf = extension === 'pdf';\n  }\n  \n  // Method 2: Check content type if filename check didn't work\n  if (!isPdf && fileData.mimeType) {\n    isPdf = fileData.mimeType.toLowerCase() === 'application/pdf';\n  }\n  \n  // Method 3: Check file signature (magic bytes) for PDF\n  if (!isPdf && fileData.data) {\n    try {\n      // PDF files start with %PDF\n      const buffer = Buffer.from(fileData.data, 'base64');\n      const header = buffer.toString('ascii', 0, 4);\n      isPdf = header === '%PDF';\n    } catch (error) {\n      // If we can't read the data, skip this method\n    }\n  }\n  \n  // Only include items that are PDFs\n  if (isPdf) {\n    items.push(item);\n  }\n}\n\nreturn items;\n"
      }
    },
