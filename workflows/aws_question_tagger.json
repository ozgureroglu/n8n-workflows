      ],
      "parameters": {
        "operation": "findOneAndUpdate",
        "collection": "questions",
        "updateKey": "=sourceDocumentId",
        "fields": "=tags, updatedAt",
        "upsert": true,
        "options": {
          "dateFields": "createdAt,updatedAt"
        }
      },
      "credentials": {
        "mongoDb": {
          "id": "YA6XhYd6cjoEZjkE",
          "name": "MongoDB aws exam_questions"
        }
      }
    },
