    {
      "id": "21808d91-e16f-483e-9d6f-23c15b9ea824",
      "name": "Resolve Config & Build Variables",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        -96
      ],
      "parameters": {
        "jsCode": "const request = $('Parse & Validate Request').first().json;\nconst platforms = $('Get Platforms Sheet').all().map(i => i.json);\nconst templates = $('Get Templates Sheet').all().map(i => i.json);\n\nconst platform = platforms.find(p => p.platform_code === request.platform_code);\nconst template = templates.find(t => t.email_type === request.email_type);\n\nif (!platform) {\n  return [{ json: { ok: false, error: `Unknown platform_code: ${request.platform_code}` } }];\n}\nif (!template) {\n  return [{ json: { ok: false, error: `Unknown email_type: ${request.email_type}` } }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    fromEmail: platform.from_email,\n    fromName: platform.from_name || platform.platform_name,\n    toEmail: request.to_email,\n    templateId: Number(template.mailjet_template_id),\n    variables: {\n      platform_name: platform.platform_name,\n      platform_description: platform.platform_description,\n      ...request.data\n    }\n  }\n}];"
      }
    },
