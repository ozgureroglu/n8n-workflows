    {
      "id": "35b42c92-846f-49b7-996b-3f3522e52d89",
      "name": "Extract changed files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2240,
        736
      ],
      "parameters": {
        "jsCode": "const branch = 'main';\nconst raw = $input.first().json;\nconst payload = raw.body ?? raw;\nif (payload.ref !== `refs/heads/${branch}`) {\n  return [{ json: { path: '', sha: '', reason: `push was to ${payload.ref}, not refs/heads/${branch}` } }];\n}\n\nconst paths = new Set();\nfor (const commit of payload.commits || []) {\n  for (const p of [...(commit.added || []), ...(commit.modified || [])]) {\n    if (p.startsWith('workflows/') && p.endsWith('.json')) {\n      paths.add(p);\n    }\n  }\n}\n\nif (paths.size === 0) {\n  return [{ json: { path: '', sha: '', reason: 'no workflows/*.json files were added or modified in this push' } }];\n}\n\nconst sha = payload.after;\nreturn Array.from(paths).map((path) => ({ json: { path, sha } }));"
      }
    },
