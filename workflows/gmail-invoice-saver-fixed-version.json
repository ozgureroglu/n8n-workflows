    {
      "id": "code-check-001",
      "name": "Check Email Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -32
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extract email data for AI to check\n// This runs for ALL emails, with or without attachments\nconst emailData = $input.item.json;\n\n// Get attachment filenames\nconst attachmentNames = emailData.attachments && emailData.attachments.length > 0 ? \n  emailData.attachments.map(a => a.filename || 'unknown').join(', ') : \n  'No attachments';\n\n// Prepare content for AI check\nreturn {\n  json: {\n    ...emailData,\n    has_attachments: emailData.attachments && emailData.attachments.length > 0,\n    check_content: `\nEmail Subject: ${emailData.subject || 'No subject'}\nEmail From: ${emailData.from || 'Unknown sender'}\nAttachments: ${attachmentNames}\nEmail Preview: ${emailData.snippet || emailData.textPlain || 'No preview'}\n    `.trim()\n  }\n};"
      }
    },
    {
      "id": "ai-agent-001",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        1424,
        -336
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Check if the email {{ $json }} includes an invoice attachment by reviewing the subject, content, and attachment. ",
        "options": {
          "systemMessage": "You are a helpful assistant who identifies invoice emails accurately. "
        }
      }
    },
