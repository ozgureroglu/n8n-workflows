    {
      "id": "code-prep-001",
      "name": "Prepare File Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        192
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Get current date info for folder organization\nconst now = new Date();\nconst year = now.getFullYear();\nconst month = String(now.getMonth() + 1).padStart(2, '0');\nconst monthName = now.toLocaleString('default', { month: 'long' });\n\nconst emailData = $input.item.json;\n\n// Clean sender name for filename\nconst senderName = (emailData.from || 'Unknown').replace(/[^a-zA-Z0-9]/g, '_').substring(0, 30);\nconst date = new Date(emailData.date || Date.now()).toISOString().split('T')[0];\n\n// Generate filename\nconst fileName = `Invoice_${date}_${senderName}`;\n\nreturn {\n  json: {\n    email_id: emailData.id,\n    email_from: emailData.from || '',\n    email_subject: emailData.subject || '',\n    email_date: emailData.date || new Date().toISOString(),\n    attachment_names: emailData.attachments?.map(a => a.filename).join(', ') || '',\n    year: year,\n    month: month,\n    month_name: monthName,\n    folder_path: `Invoices/${year}/${month}-${monthName}`,\n    file_name: fileName,\n    processed_date: new Date().toISOString()\n  }\n};"
      }
    },
